+}
+
+bool
+cl_iaw8p::check_after_inst(void)
+{
+  u8_t cc= ((class cl_m68hc11 *)uc)->cCC.get();
+  // Strict and H1 do not know the IRQ/XIRQ pin levels, so they refuse to run unmasked.
+  if (profile() < 2 && !(cc & flagI))
+    violation("interrupt", 0, -1, "I bit cleared: IRQ pin level unknown in this profile (H2 assumes it inactive)");
+  if (profile() < 2 && !(cc & flagX))
+    violation("interrupt", 0, -1, "X bit cleared: XIRQ pin level unknown in this profile (H2 assumes it inactive)");
+  last_key= cur_key;
+  return stop_pending;
+}
+
+// Opcodes that set N and Z from their own result without reading them: CLR, loads and stores.
+static bool
+iaw8p_overwrites_nz(unsigned key)
+{
+  static const u8_t ops[]= {
+    0x4f, 0x5f, 0x6f, 0x7f,
+    0x86, 0x96, 0xa6, 0xb6, 0xc6, 0xd6, 0xe6, 0xf6,	// LDAA LDAB
+    0x97, 0xa7, 0xb7, 0xd7, 0xe7, 0xf7,			// STAA STAB
+    0xcc, 0xdc, 0xec, 0xfc, 0xdd, 0xed, 0xfd,		// LDD STD
+    0xce, 0xde, 0xee, 0xfe, 0xdf, 0xef, 0xff,		// LDX/LDY STX/STY
+    0x8e, 0x9e, 0xae, 0xbe, 0x9f, 0xaf, 0xbf,		// LDS STS
+  };
+  if (key > 0x1ff)
+    return false;
+  for (unsigned i= 0; i < sizeof(ops); i++)
+    if (ops[i] == (key & 0xff))
+      return true;
+  return false;
+}
+
+// Loads that replace an accumulator and N/Z without reading the old value (LDD also covers both).
+static bool
+iaw8p_overwrites_acc(unsigned key, u8_t acc)
+{
+  static const unsigned a_ops[]= { 0x86, 0x96, 0xa6, 0xb6, 0x1a6, 0x4f, 0xcc, 0xdc, 0xec, 0xfc, 0x1ec };
+  static const unsigned b_ops[]= { 0xc6, 0xd6, 0xe6, 0xf6, 0x1e6, 0x5f, 0xcc, 0xdc, 0xec, 0xfc, 0x1ec };
+  const unsigned *ops= acc == 'A' ? a_ops : b_ops;
+  for (unsigned i= 0; i < sizeof(a_ops) / sizeof(a_ops[0]); i++)
+    if (ops[i] == key)
+      return true;
+  return false;
+}
+
+// Does opcode key (page-qualified) read the X register? Conservative: unlisted pages count as reading.
+static bool
+iaw8p_reads_x(unsigned key)
+{
+  unsigned op= key & 0xff;
+  switch (key >> 8)
+    {
+    case 0:
+      if ((op >= 0x60 && op <= 0x6f) || (op >= 0xa0 && op <= 0xaf) || (op >= 0xe0 && op <= 0xef)
+	  || (op >= 0x1c && op <= 0x1f))
+	return true;	// indexed by X
+      switch (op)
+	{
+	case 0x02: case 0x03: case 0x08: case 0x09: case 0x35: case 0x3a: case 0x3c:	// IDIV FDIV INX DEX TXS ABX PSHX
+	case 0x8c: case 0x9c: case 0xbc: case 0x8f: case 0xdf: case 0xff:		// CPX XGDX STX
+	  return true;
+	}
+      return false;
+    case 1:	// page 18: Y forms, none involves X
+      return false;
+    case 2:	// page 1A: CPD, CPY, LDY, STY indexed by X
+      return op == 0xa3 || op == 0xac || op == 0xee || op == 0xef;
+    default:	// page CD: CPX ,Y and STX ,Y (LDX ,Y only writes X)
+      return op == 0xac || op == 0xef;
+    }
+}
+
+// One instruction while a register holds unknown data (dead_acc). Returns false if the
+// instruction may read it; otherwise updates dead_acc (cleared by an overwrite, moved by XGDX).
+static bool
+iaw8p_dead_step(unsigned key, u8_t &dead)
+{
+  static const unsigned ldd[]= { 0xcc, 0xdc, 0xec, 0xfc, 0x1ec };
+  switch (dead)
+    {
+    case 'A': case 'B':
+      {
+	if (iaw8p_overwrites_acc(key, dead))
+	  {
+	    dead= 0;
+	    return true;
+	  }
+	// Neither reads the dead accumulator nor the CCR: LDX/LDY #, bit operations, the other
+	// accumulator's loads and stores.
+	static const unsigned common[]= { 0xce, 0x1ce, 0x12, 0x13, 0x14, 0x15, 0x1c, 0x1d, 0x1e, 0x1f };
+	static const unsigned a_dead[]= { 0xc6, 0xd6, 0xe6, 0xf6, 0x1e6, 0xd7, 0xe7, 0xf7, 0x1e7 };
+	static const unsigned b_dead[]= { 0x86, 0x96, 0xa6, 0xb6, 0x1a6, 0x97, 0xa7, 0xb7, 0x1a7 };
+	const unsigned *other= dead == 'A' ? a_dead : b_dead;
+	for (unsigned i= 0; i < sizeof(common) / sizeof(common[0]); i++)
+	  if (common[i] == key)
+	    return true;
+	for (unsigned i= 0; i < sizeof(a_dead) / sizeof(a_dead[0]); i++)
+	  if (other[i] == key)
+	    return true;
+	return false;
+      }
+    case 'D':
+      for (unsigned i= 0; i < sizeof(ldd) / sizeof(ldd[0]); i++)
+	if (ldd[i] == key)
+	  {
+	    dead= 0;
+	    return true;
+	  }
+      if (key == 0x8f)
+	{
+	  dead= 'X';	// XGDX: the unknown value moves to X
+	  return true;
+	}
+      return false;
+    case 'X':
+      if (key == 0xce || key == 0xde || key == 0xfe || key == 0x38 || key == 0x30 || key == 0x3ee)
+	{
+	  dead= 0;	// LDX, PULX, TSX, LDX ,Y
+	  return true;
+	}
+      return !iaw8p_reads_x(key);
+    }
+  return false;
+}
+
+// Interrupt entry while a register holds unknown data: mark its stacked copy (and the CCR copy
+// after an unknown load) so that only the matching RTI pull may read it. False if out of slots.
+bool
+cl_iaw8p::poison_stack(t_addr sp)
+{
+  t_addr slots[3];
+  u8_t tags[3];
+  int n= 0;
+  switch (dead_acc)
+    {
+    case 'A': slots[n]= sp + 3; tags[n++]= 'A'; slots[n]= sp + 1; tags[n++]= '-'; break;
+    case 'B': slots[n]= sp + 2; tags[n++]= 'B'; slots[n]= sp + 1; tags[n++]= '-'; break;
+    case 'D': slots[n]= sp + 3; tags[n++]= 'D'; slots[n]= sp + 2; tags[n++]= 'D'; break;
+    case 'X': slots[n]= sp + 4; tags[n++]= 'X'; slots[n]= sp + 5; tags[n++]= 'X'; break;
+    }
+  if (nz_unknown && dead_acc != 'A' && dead_acc != 'B')
+    { slots[n]= sp + 1; tags[n++]= '-'; }
+  int free_n= 0;
+  for (int i= 0; i < 4; i++)
+    free_n+= poison_tag[i] == 0;
+  if (free_n < n)
+    return false;
+  for (int k= 0, i= 0; k < n; i++)
+    if (!poison_tag[i])
+      {
+	poison_addr[i]= slots[k] & 0xffff;
+	poison_tag[i]= tags[k++];
+      }
+  return true;
+}
+
+// A RAM access to a poisoned stack byte: the RTI pull restores the taint, anything else stops.
+void
+cl_iaw8p::poison_pulled(t_addr a)
+{
+  for (int i= 0; i < 4; i++)
+    if (poison_tag[i] && poison_addr[i] == a)
+      {
+	if (!pulling)
+	  violation("read", a, -1, "stacked copy of a register holding unknown data");
+	else if (poison_tag[i] == '-')
+	  nz_unknown= true;
+	else
+	  dead_acc= poison_tag[i];
+	poison_tag[i]= 0;
+      }
+}
+
+bool
+cl_iaw8p::check_before_inst(unsigned key)
+{
+  if (stop_pending)
+    return true;	// never run past the first unsupported access
+  if (dead_acc && !iaw8p_dead_step(key, dead_acc))
+    {
+      violation("flags", uc->PC, -1, dead_acc == 'X' || dead_acc == 'D'
+		? "the next instruction may use an indeterminate division remainder"
+		: "the next instruction may use SPI/SCI data received from an unknown device");
+      return true;
+    }
+  if (!nz_unknown)
+    return false;
+  nz_unknown= false;
+  if (iaw8p_overwrites_nz(key))
+    return false;
+  violation("flags", uc->PC, -1, "N/Z depend on unknown input data and the next instruction may read them");
+  return true;
+}
+
+void
+cl_iaw8p::print_info(class cl_console_base *con)
+{
+  int i;
+  con->dd_printf("IAW8P profile=%d cycles=%lu inst=%lu tcnt=%u cop_services=%lu cop_cycle=%lu rom_same_writes=%lu events=%lu\n",
+		 profile(), cycles, inst(), tcnt, cop_services, cop_cycle, rom_same_writes, nev);
+  con->dd_printf("IAW8P-RUN cop_gap_max=%lu rti=%lu loop_pc=%u loop_n=%lu loop_sp_min=%u loop_sp_max=%u loop_gap_max=%lu adc_done=%d adr=%u,%u,%u,%u\n",
+		 cop_gap_max, rti_n, (unsigned)cfg_get(4 + IAW8P_ADC), loop_n, loop_sp_min, loop_sp_max,
+		 loop_gap_max, adc_done ? 1 : 0, adr[0], adr[1], adr[2], adr[3]);
+  if (stop_pending)
+    con->dd_printf("IAW8P-STOP %s\n", stop_text.c_str());
+  for (i= 0; i < IAW8P_SOURCES; i++)
+    if (irq_n[i])
+      con->dd_printf("IAW8P-IRQ %d 0x%04x %lu %lu\n", i, (unsigned)iaw8p_sources[i].vector, irq_n[i], irq_cycle[i]);
+  for (i= 0; i < 64; i++)
+    if (reg_rd[i] || reg_wr[i])
+      con->dd_printf("IAW8P-REG 0x%04x %u %lu %lu %u\n", 0x1000 + i,
+		     (i == 0x0e) ? (tcnt >> 8) : (i == 0x0f) ? (tcnt & 0xff) : reg[i], reg_rd[i], reg_wr[i],
+		     i == 0x08 ? portd_unknown : 0);
+  for (i= 0; i < 5; i++)
+    if (reg_wr[0x16 + 2 * i] || reg_wr[0x17 + 2 * i])
+      con->dd_printf("IAW8P-TOC %d %u\n", i + 1, toc[i]);
+  con->dd_printf("IAW8P-PORTA %u %u", pa_latch, pa_pins);
+  for (i= 0; i < 8; i++)
+    con->dd_printf(" %lu", pa_changes[i]);
+  con->dd_printf("\n");
+  con->dd_printf("IAW8P-SPI %lu", spi_n);
+  for (unsigned long k= spi_n > 32 ? spi_n - 32 : 0; k < spi_n; k++)
+    con->dd_printf(" %u", spi_last[k % 32]);
+  con->dd_printf("\n");
+  con->dd_printf("IAW8P-SCI %lu", sci_n);
+  for (unsigned long k= sci_n > 32 ? sci_n - 32 : 0; k < sci_n; k++)
+    con->dd_printf(" %u", sci_last[k % 32]);
+  con->dd_printf("\n");
+  con->dd_printf("IAW8P-EEPROM %d %lu ", ee_init ? 1 : 0, ee_ops);
+  for (i= 0; i < 512; i++)
+    con->dd_printf("%02x", ee[i]);
+  con->dd_printf("\n");
+  if (has_latch1040) con->dd_printf("IAW8P-LATCH 0x1040 %u\n", latch1040);
+  if (has_latch1050) con->dd_printf("IAW8P-LATCH 0x1050 %u\n", latch1050);
+  for (i= 0; i < IAW8P_REGIONS; i++)
+    con->dd_printf("IAW8P-REGION %d %lu %lu %lu\n", i, counts[i][0], counts[i][1], counts[i][2]);
+  for (i= 0; i < 256; i++)
+    if (pages[i])
+      con->dd_printf("IAW8P-PAGE %d %lu\n", i, pages[i]);
+  unsigned long first= nev > IAW8P_EVENTS ? nev - IAW8P_EVENTS : 0;
+  for (unsigned long k= first; k < nev; k++)
+    {
+      struct iaw8p_event &e= ev[k % IAW8P_EVENTS];
+      con->dd_printf("IAW8P-EV %lu %lu %lu 0x%04x %c 0x%04x %u\n", k, e.inst, e.cycle, e.pc, e.kind, e.addr, e.val);
+    }
+  con->dd_printf("IAW8P-END\n");
+}
+
+/*
+ * Checkpoint: the complete CPU, RAM and board state between two instructions, so a run can
+ * continue in a new simulator process exactly where the previous one stopped.
+ */
+
+struct iaw8p_field { const char *name; void *p; int n, size; bool sparse; };
+
+#define IAW8P_ARRAY(f, sp) { #f, (void *)(f), (int)(sizeof(f) / sizeof((f)[0])), (int)sizeof((f)[0]), sp }
+#define IAW8P_VALUE(f) { #f, (void *)&(f), 1, (int)sizeof(f), false }
+#define IAW8P_STATE_FIELDS(b) {							\
+    IAW8P_VALUE(b->cycles), IAW8P_VALUE(b->cop_cycle), IAW8P_VALUE(b->cop_services),	\
+    IAW8P_VALUE(b->cop_gap_max), IAW8P_VALUE(b->rom_same_writes),			\
+    { "counts", (void *)b->counts, IAW8P_REGIONS * 3, (int)sizeof(unsigned long), false }, \
+    IAW8P_ARRAY(b->pages, false), IAW8P_ARRAY(b->first_op, true),			\
+    IAW8P_ARRAY(b->first_pc, true), IAW8P_ARRAY(b->exec_pc, true),			\
+    IAW8P_ARRAY(b->reg_rd, false), IAW8P_ARRAY(b->reg_wr, false),			\
+    IAW8P_VALUE(b->adc_start), IAW8P_VALUE(b->nev),					\
+    IAW8P_ARRAY(b->irq_n, false), IAW8P_ARRAY(b->irq_cycle, false), IAW8P_VALUE(b->rti_n), \
+    IAW8P_VALUE(b->loop_n), IAW8P_VALUE(b->loop_cycle), IAW8P_VALUE(b->loop_gap_max),	\
+    IAW8P_VALUE(b->loop_sp_min), IAW8P_VALUE(b->loop_sp_max), \
+    IAW8P_ARRAY(b->reg, false), IAW8P_VALUE(b->latch1040),	\
+    IAW8P_VALUE(b->latch1050), IAW8P_ARRAY(b->adr, false), IAW8P_VALUE(b->init_written), \
+    IAW8P_VALUE(b->prescaler_written), IAW8P_VALUE(b->cop_armed), IAW8P_VALUE(b->adc_busy), \
+    IAW8P_VALUE(b->adc_done), IAW8P_VALUE(b->has_latch1040), IAW8P_VALUE(b->has_latch1050), \
+    IAW8P_VALUE(b->tcnt), IAW8P_ARRAY(b->toc, false), IAW8P_VALUE(b->presc),		\
+    IAW8P_VALUE(b->pa_latch), IAW8P_VALUE(b->pa_pins), IAW8P_ARRAY(b->pa_changes, false),	\
+    IAW8P_VALUE(b->spi_busy), IAW8P_VALUE(b->spi_end), IAW8P_VALUE(b->spi_n),		\
+    IAW8P_VALUE(b->spsr_seen), IAW8P_ARRAY(b->spi_last, false), IAW8P_VALUE(b->dead_acc), IAW8P_ARRAY(b->poison_addr, false), IAW8P_ARRAY(b->poison_tag, false),	\
+    IAW8P_ARRAY(b->ee, false), IAW8P_VALUE(b->ee_init), IAW8P_VALUE(b->ee_latched),		\
+    IAW8P_VALUE(b->sci_tdr), IAW8P_VALUE(b->scsr_seen), IAW8P_VALUE(b->sci_tdr_full),	\
+    IAW8P_VALUE(b->sci_shifting), IAW8P_VALUE(b->sci_preamble), IAW8P_VALUE(b->sci_shift_end), \
+    IAW8P_VALUE(b->sci_n), IAW8P_ARRAY(b->sci_last, false),				\
+    IAW8P_VALUE(b->ee_addr), IAW8P_VALUE(b->ee_data), IAW8P_VALUE(b->ee_pgm_cycle),		\
+    IAW8P_VALUE(b->ee_ops),								\
+    IAW8P_VALUE(b->last_key), IAW8P_VALUE(b->nz_unknown), IAW8P_VALUE(b->portd_unknown),	\
+    IAW8P_VALUE(b->crank_acc), IAW8P_VALUE(b->crank_pos), IAW8P_VALUE(b->crank_level),	\
+    IAW8P_VALUE(b->crank_edges), IAW8P_VALUE(b->crank_rises), IAW8P_ARRAY(b->tic, false),	\
+    IAW8P_VALUE(b->tic_valid), IAW8P_ARRAY(b->pa_edge_cycle, false), IAW8P_ARRAY(b->pa_high_w, false), \
+    IAW8P_ARRAY(b->pa_low_w, false), IAW8P_ARRAY(b->latch_changes, false) }
+
+static unsigned long
+iaw8p_get(const struct iaw8p_field &f, int i)
+{
+  const char *p= (const char *)f.p + (size_t)i * f.size;
+  switch (f.size)
+    {
+    case 1: return *(const u8_t *)p;
+    case 2: return *(const u16_t *)p;
+    case 4: return *(const u32_t *)p;
+    default: return *(const unsigned long *)p;
+    }
+}
+
+static bool
+iaw8p_put(const struct iaw8p_field &f, int i, unsigned long v)
+{
+  char *p= (char *)f.p + (size_t)i * f.size;
+  if (f.size < 8 && v >> (8 * f.size))
+    return false;
+  switch (f.size)
+    {
+    case 1: *(u8_t *)p= v; break;
+    case 2: *(u16_t *)p= v; break;
+    case 4: *(u32_t *)p= v; break;
+    default: *(unsigned long *)p= v; break;
+    }
+  return true;
+}
+
+#define IAW8P_STATE_VERSION 2
+static const t_addr iaw8p_ram[2][2]= { { 0x0000, 0x0100 }, { 0x2000, 0x0800 } };
+
+bool
+cl_iaw8p::save(const char *path)
+{
+  class cl_m68hc11 *u= (class cl_m68hc11 *)uc;
+  cl_iaw8p *b= this;
+  const struct iaw8p_field fields[]= IAW8P_STATE_FIELDS(b);
+  FILE *f= fopen(path, "w");
+  if (!f)
+    return false;
+  fprintf(f, "IAW8P-STATE %d\ninst %lu\n", IAW8P_STATE_VERSION, inst());
+  fprintf(f, "cpu %u %u %u %u %u %u %u\n", u->acc.DAB.a8.Ar, u->acc.DAB.a8.Br, u->IX, u->IY, u->SP,
+	  (unsigned)u->PC, u->CC.cc16.cc8.ccl);
+  for (int r= 0; r < 2; r++)
+    {
+      fprintf(f, "mem %u ", (unsigned)iaw8p_ram[r][0]);
+      for (t_addr a= iaw8p_ram[r][0]; a < iaw8p_ram[r][0] + iaw8p_ram[r][1]; a++)
+	fprintf(f, "%02x", (unsigned)uc->rom->get(a));
+      fprintf(f, "\n");
+    }
+  for (unsigned k= 0; k < sizeof(fields) / sizeof(fields[0]); k++)
+    {
+      const struct iaw8p_field &d= fields[k];
+      const char *name= strrchr(d.name, '>') ? strrchr(d.name, '>') + 1 : d.name;
+      int nz= 0;
+      for (int i= 0; i < d.n; i++)
+	nz+= iaw8p_get(d, i) != 0;
+      if (d.sparse)
+	{
+	  fprintf(f, "s %s %d %d", name, d.n, nz);
+	  for (int i= 0; i < d.n; i++)
+	    if (iaw8p_get(d, i))
+	      fprintf(f, " %d %lu", i, iaw8p_get(d, i));
+	}
+      else
+	{
+	  fprintf(f, "f %s %d", name, d.n);
+	  for (int i= 0; i < d.n; i++)
+	    fprintf(f, " %lu", iaw8p_get(d, i));
+	}
+      fprintf(f, "\n");
+    }
+  for (int k= 0; k < IAW8P_EVENTS; k++)
+    fprintf(f, "ev %d %lu %lu %u %u %u %u\n", k, ev[k].inst, ev[k].cycle, ev[k].pc, ev[k].addr, ev[k].val,
+	    (unsigned)(u8_t)ev[k].kind);
+  fprintf(f, "end\n");
+  return fclose(f) == 0;
+}
+
+// Restores a checkpoint written by save(); any malformed or missing part rejects the whole file.
+bool
+cl_iaw8p::load(const char *path, class cl_console_base *con)
+{
+  class cl_m68hc11 *u= (class cl_m68hc11 *)uc;
+  cl_iaw8p *b= this;
+  const struct iaw8p_field fields[]= IAW8P_STATE_FIELDS(b);
+  const unsigned nf= sizeof(fields) / sizeof(fields[0]);
+  bool seen[nf];
+  memset(seen, 0, sizeof(seen));
+  FILE *f= fopen(path, "r");
+  if (!f)
+    return false;
+  int version= 0, evs= 0, mems= 0;
+  unsigned long saved_inst= 0;
+  unsigned ra, rb, rx, ry, rsp, rpc, rcc;
+  bool ok= fscanf(f, "IAW8P-STATE %d inst %lu cpu %u %u %u %u %u %u %u", &version, &saved_inst,
+		  &ra, &rb, &rx, &ry, &rsp, &rpc, &rcc) == 9
+    && version == IAW8P_STATE_VERSION && ra < 256 && rb < 256 && rx < 0x10000 && ry < 0x10000
+    && rsp < 0x10000 && rpc < 0x10000 && rcc < 256;
+  static char hex[2 * 0x800 + 2];
+  char tag[16], name[32];
+  while (ok && fscanf(f, "%15s", tag) == 1)
+    {
+      if (!strcmp(tag, "end"))
+	break;
+      if (!strcmp(tag, "mem"))
+	{
+	  unsigned base;
+	  int r= mems;
+	  ok= r < 2 && fscanf(f, "%u %4097s", &base, hex) == 2 && base == iaw8p_ram[r][0]
+	    && strlen(hex) == 2 * iaw8p_ram[r][1];
+	  for (t_addr i= 0; ok && i < iaw8p_ram[r][1]; i++)
+	    {
+	      unsigned v;
+	      ok= sscanf(hex + 2 * i, "%2x", &v) == 1;
+	      uc->rom->set(base + i, v);
+	    }
+	  mems++;
+	}
+      else if (!strcmp(tag, "ev"))
+	{
+	  int k;
+	  unsigned long ei, ec;
+	  unsigned pc, addr, val, kind;
+	  ok= fscanf(f, "%d %lu %lu %u %u %u %u", &k, &ei, &ec, &pc, &addr, &val, &kind) == 7
+	    && k == evs && pc < 0x10000 && addr < 0x10000 && val < 256 && kind < 128;
+	  if (ok)
+	    {
+	      ev[k].inst= ei; ev[k].cycle= ec; ev[k].pc= pc; ev[k].addr= addr; ev[k].val= val; ev[k].kind= kind;
+	    }
+	  evs++;
+	  ok= ok && evs <= IAW8P_EVENTS;
+	}
+      else if (!strcmp(tag, "f") || !strcmp(tag, "s"))
+	{
+	  int n= -1, k;
+	  ok= fscanf(f, "%31s %d", name, &n) == 2;
+	  for (k= 0; ok && k < (int)nf; k++)
+	    {
+	      const char *fn= strrchr(fields[k].name, '>') ? strrchr(fields[k].name, '>') + 1 : fields[k].name;
+	      if (!strcmp(fn, name))
+		break;
+	    }
+	  ok= ok && k < (int)nf && !seen[k] && n == fields[k].n && fields[k].sparse == (tag[0] == 's');
+	  if (!ok)
+	    break;
+	  seen[k]= true;
+	  const struct iaw8p_field &d= fields[k];
+	  memset(d.p, 0, (size_t)d.n * d.size);
+	  if (d.sparse)
+	    {
+	      int nz;
+	      ok= fscanf(f, "%d", &nz) == 1 && nz >= 0 && nz <= d.n;
+	      for (int j= 0; ok && j < nz; j++)
+		{
+		  int i;
+		  unsigned long v;
+		  ok= fscanf(f, "%d %lu", &i, &v) == 2 && i >= 0 && i < d.n && iaw8p_put(d, i, v);
+		}
+	    }
+	  else
+	    for (int i= 0; ok && i < d.n; i++)
+	      {
+		unsigned long v;
+		ok= fscanf(f, "%lu", &v) == 1 && iaw8p_put(d, i, v);
+	      }
+	}
+      else
+	ok= false;
+    }
+  fclose(f);
+  for (unsigned k= 0; ok && k < nf; k++)
+    ok= seen[k];
+  ok= ok && mems == 2 && evs == IAW8P_EVENTS && saved_inst >= uc->vc.inst;
+  if (!ok)
+    {
+      // Never run from a partly restored state.
+      violation("checkpoint", 0, -1, "checkpoint file malformed or incomplete");
+      return false;
+    }
+  inst_base= saved_inst - uc->vc.inst;
+  u->acc.DAB.a8.Ar= ra;
+  u->acc.DAB.a8.Br= rb;
+  u->IX= rx;
+  u->IY= ry;
+  u->SP= rsp;
+  u->PC= rpc;
+  u->cPC.W(rpc);
+  u->CC.cc16.cc8.ccl= rcc;
+  stop_pending= false;
+  stop_text= "";
+  cur_key= 0;
+  return true;
+}
+
+bool
+cl_iaw8p::set_cmd(class cl_cmdline *cmdline, class cl_console_base *con)
+{
+  class cl_cmd_arg *p0= cmdline->param(0), *p1= cmdline->param(1), *p2= cmdline->param(2);
+  if (cmdline->syntax_match(uc, STRING STRING))
+    {
+      chars op= p0->get_svalue(), path= p1->get_svalue();
+      if (op == "sample")
+	{
+	  // Sample plus the bytes at a comma-separated list of hex addresses (read without side effects).
+	  class cl_m68hc11 *u= (class cl_m68hc11 *)uc;
+	  con->dd_printf("IAW8P-SAMPLE %lu %lu %u %u %u %u %u %u %u %lu %u |", inst(), cycles, (unsigned)u->PC, u->SP,
+			 u->acc.DAB.a8.Ar, u->acc.DAB.a8.Br, u->IX, u->IY, u->CC.cc16.cc8.ccl, crank_edges, crank_pos);
+	  const char *p= path.c_str();
+	  for (int k= 0; *p && k < 32; k++)
+	    {
+	      char *end;
+	      unsigned long addr= strtoul(p, &end, 16);
+	      if (end == p || addr > 0xffff)
+		break;
+	      con->dd_printf(" %u", (unsigned)uc->rom->get(addr));
+	      p= *end == ',' ? end + 1 : end;
+	    }
+	  con->dd_printf("\n");
+	}
+      else if (op == "save")
+	con->dd_printf(save(path.c_str()) ? "IAW8P-SAVED\n" : "IAW8P-SAVE-ERROR\n");
+      else if (op == "load")
+	con->dd_printf(load(path.c_str(), con) ? "IAW8P-LOADED\n" : "IAW8P-LOAD-ERROR\n");
+      else
+	return false;
+      return true;
+    }
+  if (cmdline->syntax_match(uc, STRING) && chars(p0->get_svalue()) == "sample")
+    {
+      class cl_m68hc11 *u= (class cl_m68hc11 *)uc;
+      con->dd_printf("IAW8P-SAMPLE %lu %lu %u %u %u %u %u %u %u\n", inst(), cycles, (unsigned)u->PC, u->SP,
+		     u->acc.DAB.a8.Ar, u->acc.DAB.a8.Br, u->IX, u->IY, u->CC.cc16.cc8.ccl);
+      return true;
+    }
+  // Test scaffolding for the interrupt conformance cases: set a modelled register's raw state.
+  if (cmdline->syntax_match(uc, STRING NUMBER NUMBER) && chars(p0->get_svalue()) == "reg"
+      && p1->value.number >= 0 && p1->value.number < 64 && p2->value.number >= 0 && p2->value.number < 256)
+    {
+      reg[p1->value.number]= p2->value.number;
+      return true;
+    }
+  return false;
+}
+
+void
+cl_iaw8p::set_help(class cl_console_base *con)
+{
+  con->dd_printf("set hardware iaw8p save|load FILE | sample [HEXADDR,...] | reg N VALUE\n");
+}
+
+void
+CL11::mk_hw_elements(void)
+{
+  cl_m68hcbase::mk_hw_elements();	// CPU interrupt plumbing only (generic_board() is false)
+  add_hw(board= new cl_iaw8p(this));
+  board->init();
+}
+
+// HC11 stacking order PCL, PCH, IYL, IYH, IXL, IXH, ACCA, ACCB, CCR (manual 5.5.1, SWI cycles 3-11).
+void
+CL11::push_regs(bool inst_part)
+{
+  rom->write(rSP--, PC&0xff);
+  rom->write(rSP--, PC>>8);
+  rom->write(rSP--, rIY&0xff);
+  rom->write(rSP--, rIY>>8);
+  rom->write(rSP--, rIX&0xff);
+  rom->write(rSP--, rIX>>8);
+  rom->write(rSP--, rA);
+  rom->write(rSP--, rB);
+  rom->write(rSP--, rCC);
+  if (!inst_part)
+    tick(12);
+}
+
+// RTI: reverse order; X may be cleared but never set by the restored CCR (manual RTI description).
+void
+CL11::pull_regs(bool inst_part)
+{
+  if (board)
+    {
+      board->dead_acc= 0;	// every register is replaced from the stack (a marked copy restores its taint)
+      board->pulling= true;
+    }
+  u8_t l, h, cc= rom->read(++rSP);
+  if (!(rCC & flagX))
+    cc&= ~flagX;
+  rCC= cc;
+  rB= rom->read(++rSP);
+  rA= rom->read(++rSP);
+  h= rom->read(++rSP);
+  l= rom->read(++rSP);
+  rIX= h*256+l;
+  h= rom->read(++rSP);
+  l= rom->read(++rSP);
+  rIY= h*256+l;
+  h= rom->read(++rSP);
+  l= rom->read(++rSP);
+  PC= h*256+l;
+  if (board)
+    board->pulling= false;
+  if (!inst_part)
+    tick(12);
+  if (board)
+    board->rti_done(PC);
+}
+
+int
+CL11::exec_inst(void)
+{
+  if (board && !board->stop_pending)
+    {
+      int s= board->pending_source();
+      if (board->stop_pending)
+	return resINV_ADDR;
+      if (s >= 0)
+	{
+	  // Interrupt response between instructions: stack, set I, fetch the vector, 12 E cycles
+	  // (cycles 3-14 of SWI, manual 5.5.1); then the first handler instruction runs. A register
+	  // with unknown data stays unknown in the handler, and its stacked copy is marked.
+	  t_addr vector= board->vector_of(s);
+	  push_regs(true);
+	  if ((board->dead_acc || board->nz_unknown) && !board->poison_stack(rSP))
+	    {
+	      board->violation("interrupt", 0, -1, "nested interrupts would stack too many registers holding unknown data");
+	      return resINV_ADDR;
+	    }
+	  rCC|= flagI;
+	  PC= read_addr(rom, vector);
+	  tick(12);
+	  board->interrupt_taken(s, vector);
+	  instPC= PC;
+	}
+    }
+  t_mem c= rom->get(PC);
+  unsigned key= c;
+  if (c == 0x18) key= 0x100 + rom->get(PC+1);
+  else if (c == 0x1a) key= 0x200 + rom->get(PC+1);
+  else if (c == 0xcd) key= 0x300 + rom->get(PC+1);
+  if (board && board->check_before_inst(key))
+    return resINV_ADDR;	// not executed
+  if (board)
+    board->opcode(key, PC);
+  bool was_masked= (rCC & flagI) != 0;
+  int res= cl_m68hcbase::exec_inst();
+  if (board && board->check_after_inst() && res < resSTOP)
+    res= resINV_ADDR;
+  // CLI delays IRQ recognition only when it actually enables interrupts (manual 5.7.2).
+  if (board && key == 0x0e && !was_masked)
+    board->last_key= 0;
+  return res;
+}
