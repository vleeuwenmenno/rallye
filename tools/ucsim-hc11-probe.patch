+/*
+ * Research board model for one Magneti Marelli IAW8P firmware study.
+ * Every region and register here is a documented hypothesis; any CPU access
+ * that is not modelled stops the simulation after that instruction.
+ */
+#define IAW8P_REGIONS 7
+#define IAW8P_EVENTS 256
+#define IAW8P_SOURCES 15	// I-maskable interrupt sources in Figure 5-4 order
+#define IAW8P_ADC 8
+#define IAW8P_E_HZ 2000000UL	// assumed E clock (8 MHz crystal / 4): converts commanded rpm to E cycles
+#define IAW8P_CRANK_MAX 9000	// iaw8p_crank_rpm above this: no crank signal modelled
+
+struct iaw8p_event {
+  unsigned long inst, cycle;
+  u16_t pc, addr;
+  u8_t val;
+  char kind;		// R read, W write, L latch write, C COP service,
+			// I interrupt entry (addr: vector, val: source), T RTI (addr: return PC)
+};
+
+class cl_iaw8p: public cl_hw
+{
+public:
+  // Saved and restored by "set hardware iaw8p save/load" (see IAW8P_STATE_FIELDS).
+  unsigned long cycles, inst_base, cop_cycle, cop_services, cop_gap_max, rom_same_writes;
+  unsigned long counts[IAW8P_REGIONS][3];	// opcode/operand fetch, data read, data write
+  unsigned long pages[256];			// instructions started per 256-byte page
+  unsigned long first_op[4*256];		// instruction number of first execution, 0: never
+  unsigned long first_pc[0x10000];	// same, per instruction address
+  unsigned long exec_pc[0x10000];		// instructions started per address
+  unsigned long reg_rd[64], reg_wr[64];
+  unsigned long adc_start;
+  struct iaw8p_event ev[IAW8P_EVENTS];
+  unsigned long nev;
+  unsigned long irq_n[IAW8P_SOURCES], irq_cycle[IAW8P_SOURCES], rti_n;
+  unsigned long loop_n, loop_cycle, loop_gap_max;
