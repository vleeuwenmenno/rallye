+/*
+ * IAW8P research board (see cl_iaw8p in m68hc11cl.h)
+ */
+
+// Regions; the address ranges are hypotheses recorded in the rallye docs.
+static const struct { t_addr lo, hi; const char *name; } iaw8p_regions[IAW8P_REGIONS]= {
+  { 0x0000, 0x00ff, "internal_ram" },	// HC11 A-family reset location (INIT=$01)
+  { 0x0100, 0x0fff, "unmapped" },
+  { 0x1000, 0x103f, "registers" },	// HC11 register block at INIT=$01
+  { 0x1040, 0x1fff, "external_io" },	// board decode unknown
+  { 0x2000, 0x27ff, "external_ram" },	// inferred: SP=$27FF, RAM test $2000-$27F9
+  { 0x2800, 0x3fff, "unmapped" },	// dump bytes are all zero here
+  { 0x4000, 0xffff, "eprom" },		// read-only image, file offset = CPU address
+};
+
+// I-maskable interrupt sources in the fixed priority order of the reference manual's
+// Figure 5-4, after the source HPRIO PSEL promotes (Table 5-4 codes).
+static const struct { u8_t psel; t_addr vector; u8_t flag_reg, flag_bit, mask_reg, mask_bit; } iaw8p_sources[IAW8P_SOURCES]= {
+  {  6, 0xfff2, 0, 0, 0, 0 },			// 0 IRQ pin: unknown (strict/H1), inactive (H2)
+  {  7, 0xfff0, 0x25, 0x40, 0x24, 0x40 },	// 1 RTI: RTIF/RTII
+  {  8, 0xffee, 0x23, 0x04, 0x22, 0x04 },	// 2 IC1
+  {  9, 0xffec, 0x23, 0x02, 0x22, 0x02 },	// 3 IC2
+  { 10, 0xffea, 0x23, 0x01, 0x22, 0x01 },	// 4 IC3
+  { 11, 0xffe8, 0x23, 0x80, 0x22, 0x80 },	// 5 OC1
+  { 12, 0xffe6, 0x23, 0x40, 0x22, 0x40 },	// 6 OC2
+  { 13, 0xffe4, 0x23, 0x20, 0x22, 0x20 },	// 7 OC3
+  { 14, 0xffe2, 0x23, 0x10, 0x22, 0x10 },	// 8 OC4
+  { 15, 0xffe0, 0x23, 0x08, 0x22, 0x08 },	// 9 OC5 (I4/O5)
+  {  0, 0xffde, 0x25, 0x80, 0x24, 0x80 },	// 10 TOF
+  {  1, 0xffdc, 0x25, 0x20, 0x24, 0x20 },	// 11 PAOV
+  {  2, 0xffda, 0x25, 0x10, 0x24, 0x10 },	// 12 PAI
+  {  3, 0xffd8, 0, 0, 0, 0 },			// 13 SPI: SPIF or MODF with SPIE
+  {  4, 0xffd6, 0, 0, 0, 0 },			// 14 SCI: Figure 5-5 with an idle receive line
+};
+
+#define IAW8P_NOT_SUPPLIED 0x100	// input cfg value: no simulated input given
+
+cl_iaw8p::cl_iaw8p(class cl_uc *auc):
+  cl_hw(auc, HW_DUMMY, 0, "iaw8p")
+{
+}
+
+int
+cl_iaw8p::init(void)
+{
+  cl_hw::init();
+  for (t_addr a= 0; a <= 0xffff; a++)
+    register_cell(uc->rom, a);
+  class cl_var *v;
+  uc->vars->add(v= new cl_var("iaw8p_profile", cfg, 1, "IAW8P board profile: 0 strict, 1 hypothesis H1, 2 simulation profile H2"));
+  v->init();
+  uc->vars->add(v= new cl_var("iaw8p_cycles", cfg, 2, "E cycles since reset (read only)"));
+  v->init();
+  uc->vars->add(v= new cl_var("iaw8p_in1060", cfg, 3, "H2 input: board input byte $1060 (0-255; 256: not supplied)"));
+  v->init();
+  for (int k= 0; k < IAW8P_ADC; k++)
+    {
+      chars n, d;
+      n.format("iaw8p_adc%d", k);
+      d.format("H2 input: raw A/D result of channel AN%d (0-255; 256: not supplied)", k);
+      uc->vars->add(v= new cl_var(n, cfg, 4 + k, d));
+      v->init();
+    }
+  uc->vars->add(v= new cl_var("iaw8p_loop_pc", cfg, 4 + IAW8P_ADC, "PC whose visits, SP range and period are counted"));
+  v->init();
+  uc->vars->add(v= new cl_var("iaw8p_porta_in", cfg, 5 + IAW8P_ADC, "H2 input: PORTA input pin levels PA0-PA2, PA7 (0-255; 256: not supplied)"));
+  v->init();
+  for (int k= 3; k < 4 + IAW8P_ADC; k++)
+    cfg_set(k, IAW8P_NOT_SUPPLIED);
+  uc->vars->add(v= new cl_var("iaw8p_portd_in", cfg, 6 + IAW8P_ADC, "H2 input: PORTD input pin levels PD0-PD5 (0-63; 256: not supplied)"));
+  v->init();
+  uc->vars->add(v= new cl_var("iaw8p_in1080", cfg, 7 + IAW8P_ADC, "H2 input: board input byte $1080 (0-255; 256: not supplied)"));
+  v->init();
+  uc->vars->add(v= new cl_var("iaw8p_eeprom_fill", cfg, 8 + IAW8P_ADC, "H2 input: internal EEPROM content at power-up, one byte value (256: not supplied)"));
+  v->init();
+  uc->vars->add(v= new cl_var("iaw8p_crank_rpm", cfg, 9 + IAW8P_ADC, "H2 input: commanded crank speed of the simulated 60-2 wheel on PA7/PA0, rpm at the assumed 2 MHz E clock (0: stopped; above 9000: no crank signal)"));
+  v->init();
+  for (int k= 5; k <= 9; k++)
+    cfg_set(k + IAW8P_ADC, IAW8P_NOT_SUPPLIED);
+  reset();
+  return 0;
+}
+
+void
+cl_iaw8p::reset(void)
+{
+  cycles= inst_base= cop_cycle= cop_services= cop_gap_max= rom_same_writes= adc_start= nev= 0;
+  rti_n= loop_n= loop_cycle= loop_gap_max= 0;
+  memset(counts, 0, sizeof(counts));
+  memset(pages, 0, sizeof(pages));
+  memset(first_op, 0, sizeof(first_op));
+  memset(first_pc, 0, sizeof(first_pc));
+  memset(exec_pc, 0, sizeof(exec_pc));
+  memset(reg_rd, 0, sizeof(reg_rd));
+  memset(reg_wr, 0, sizeof(reg_wr));
+  memset(reg, 0, sizeof(reg));
+  memset(ev, 0, sizeof(ev));
+  memset(irq_n, 0, sizeof(irq_n));
+  memset(irq_cycle, 0, sizeof(irq_cycle));
+  memset(adr, 0, sizeof(adr));
+  // Reset values from the HC11 reference manual for the registers this model implements.
+  reg[0x3d]= 0x01;	// INIT
+  reg[0x39]= 0x00;	// OPTION (only the bits this model reads matter)
+  reg[0x3c]= 0x26;	// HPRIO in normal expanded mode (MDA=1, PSEL=0110): inferred mode
+  for (int k= 0; k < 5; k++)
+    toc[k]= 0xffff;	// TOC1-TOC5 reset to $FFFF
+  latch1040= latch1050= 0;
+  init_written= prescaler_written= cop_armed= adc_busy= adc_done= has_latch1040= has_latch1050= false;
+  tcnt= 0;
+  presc= 0;
+  pa_latch= pa_pins= 0;	// PORTA output pins are low out of reset; PA7 is an input (DDRA7=0)
+  memset(pa_changes, 0, sizeof(pa_changes));
+  memset(pa_edge_cycle, 0, sizeof(pa_edge_cycle));
+  memset(pa_high_w, 0, sizeof(pa_high_w));
+  memset(pa_low_w, 0, sizeof(pa_low_w));
+  memset(latch_changes, 0, sizeof(latch_changes));
+  // The wheel rests in the gap just before tooth 1 (signal high); fixed so every run is reproducible.
+  crank_acc= 0;
+  crank_pos= 119;
+  crank_level= 1;
+  crank_edges= crank_rises= 0;
+  memset(tic, 0, sizeof(tic));
+  tic_valid= 0;
+  spi_busy= false;
+  spi_end= spi_n= 0;
+  spsr_seen= dead_acc= 0;
+  memset(poison_addr, 0, sizeof(poison_addr));
+  memset(poison_tag, 0, sizeof(poison_tag));
+  pulling= false;
+  sci_tdr= scsr_seen= 0;
+  sci_tdr_full= sci_shifting= sci_preamble= false;
+  sci_shift_end= sci_n= 0;
+  memset(sci_last, 0, sizeof(sci_last));
+  memset(ee, 0, sizeof(ee));
+  ee_init= ee_latched= false;
+  ee_addr= ee_data= 0;
+  ee_pgm_cycle= ee_ops= 0;
+  memset(spi_last, 0, sizeof(spi_last));
+  loop_sp_min= 0xffff;
+  loop_sp_max= 0;
+  last_key= 0;
+  stop_pending= false;
+  stop_text= "";
+  cur_key= 0;
+  nz_unknown= false;
+  portd_unknown= 0;
+}
+
+t_mem
+cl_iaw8p::conf_op(cl_memory_cell *cell, t_addr addr, t_mem *val)
+{
+  if (addr == 2)
+    {
+      cell->set(cycles);
+      if (val)
+	*val= cycles;	// read only
+      return cell->get();
+    }
+  return cl_hw::conf_op(cell, addr, val);
+}
+
+int
+cl_iaw8p::profile(void)
+{
+  return cfg ? (int)cfg_get(1) : 0;
+}
+
+int
+cl_iaw8p::region(t_addr a)
+{
+  for (int i= 0; i < IAW8P_REGIONS; i++)
+    if (a >= iaw8p_regions[i].lo && a <= iaw8p_regions[i].hi)
+      return i;
+  return 1;
+}
+
+void
+cl_iaw8p::violation(const char *kind, t_addr a, int val, const char *why)
+{
+  if (stop_pending)
+    return;	// the first unsupported access of an instruction is the one reported
+  stop_pending= true;
+  stop_text.format("kind=%s addr=0x%04x val=%d pc=0x%04x inst=%lu why=%s",
+		   kind, (unsigned)a, val, (unsigned)uc->instPC, inst(), why);
+}
+
+void
+cl_iaw8p::event(char kind, t_addr a, u8_t val)
+{
+  struct iaw8p_event &e= ev[nev % IAW8P_EVENTS];
+  e.inst= inst();
+  e.cycle= cycles;
+  e.pc= uc->instPC;
+  e.addr= a;
+  e.val= val;
+  e.kind= kind;
+  nev++;
+}
+
+void
+cl_iaw8p::opcode(unsigned key, t_addr pc)
+{
+  class cl_m68hc11 *u= (class cl_m68hc11 *)uc;
+  cur_key= key;
+  pages[(pc >> 8) & 0xff]++;
+  exec_pc[pc & 0xffff]++;
+  if (!first_op[key])
+    first_op[key]= inst();
+  if (!first_pc[pc & 0xffff])
+    first_pc[pc & 0xffff]= inst();
+  t_addr loop_pc= cfg_get(4 + IAW8P_ADC);
+  if (loop_pc && pc == loop_pc)
+    {
+      if (loop_n && cycles - loop_cycle > loop_gap_max)
+	loop_gap_max= cycles - loop_cycle;
+      loop_n++;
+      loop_cycle= cycles;
+      if (u->SP < loop_sp_min) loop_sp_min= u->SP;
+      if (u->SP > loop_sp_max) loop_sp_max= u->SP;
+    }
+}
+
+static int
+prescale(u8_t tmsk2)
+{
+  static const int p[4]= { 1, 4, 8, 16 };
+  return p[tmsk2 & 3];
+}
+
+bool
+cl_iaw8p::crank_on(void)
+{
+  return profile() == 2 && cfg_get(9 + IAW8P_ADC) <= IAW8P_CRANK_MAX;
+}
+
+// One edge of the simulated crank signal, seen by the pulse accumulator (PA7/PAI) and input
+// capture 3 (PA0/IC3) in the same E cycle (manual sections 7.4, 7.6, 10.2).
+void
+cl_iaw8p::crank_edge(bool rising)
+{
+  if (rising)
+    crank_rises++;
+  else
+    crank_edges++;
+  if (reg[0x26] & 0x80)
+    violation("input", 0x1000, -1, "PA7 is an output (DDRA7=1) while the simulated crank signal drives it");
+  else if (((reg[0x26] & 0x10) != 0) == rising)	// PEDGE: 0 falling, 1 rising
+    {
+      reg[0x25]|= 0x10;	// PAIF
+      if ((reg[0x26] & 0x60) == 0x40 && ++reg[0x27] == 0)
+	reg[0x25]|= 0x20;	// PAOVF on the PACNT $FF -> $00 transition (event-counting mode)
+      else if ((reg[0x26] & 0x60) == 0x60)
+	violation("input", 0x1026, reg[0x26], "PACTL gated time accumulation with a crank signal: not modelled");
+    }
+  u8_t edg3= reg[0x21] & 0x03;	// TCTL2 EDG3B:EDG3A: 01 rising, 10 falling, 11 any
+  if (edg3 == 3 || edg3 == (rising ? 1 : 2))
+    {
+      tic[2]= tcnt;
+      tic_valid|= 4;
+      reg[0x23]|= 0x01;	// IC3F
+    }
+}
+
+int
+cl_iaw8p::tick(int n)
+{
+  // Commanded speed: 120 half-teeth per revolution, so 2*rpm half-teeth per second.
+  unsigned long rpm= crank_on() ? cfg_get(9 + IAW8P_ADC) : 0;
+  while (n-- > 0)
+    {
+      cycles++;
+      if (++presc >= (unsigned)prescale(reg[0x24]))
+	{
+	  presc= 0;
+	  if (++tcnt == 0)
+	    reg[0x25]|= 0x80;	// TOF
+	  // OCxF and the pin action on a TCNT match; OC1 last, so it overrides on a shared pin (manual 7.5.1)
+	  for (int k= 4; k >= 0; k--)
+	    if (tcnt == toc[k])
+	      {
+		reg[0x23]|= 0x80 >> k;
+		oc_action(k);
+	      }
+	}
+      if (rpm && (crank_acc+= 2 * rpm) >= IAW8P_E_HZ)
+	{
+	  crank_acc-= IAW8P_E_HZ;
+	  crank_pos= (crank_pos + 1) % 120;
+	  u8_t lvl= (crank_pos < 116 && !(crank_pos & 1)) ? 0 : 1;	// teeth 59 and 60 missing
+	  if (lvl != crank_level)
+	    {
+	      crank_level= lvl;
+	      crank_edge(lvl);
+	    }
+	}
+      // RTI: E/2^13 times 1, 2, 4 or 8 (PACTL RTR1:0), counted from reset
+      if ((cycles % ((unsigned long)8192 << (reg[0x26] & 3))) == 0)
+	reg[0x25]|= 0x40;	// RTIF
+      if (sci_shifting && cycles >= sci_shift_end)
+	sci_shifting= false;
+      if (!sci_shifting && (reg[0x2d] & 0x08) && (sci_preamble || sci_tdr_full))
+	{
+	  // Shifter takes the queued idle preamble, else the TDR character (manual 9.4/9.7).
+	  static const int scp[4]= { 1, 3, 4, 13 };
+	  unsigned long bit= 16UL * scp[(reg[0x2b] >> 4) & 3] << (reg[0x2b] & 7);
+	  sci_shifting= true;
+	  sci_shift_end= cycles + bit * ((reg[0x2c] & 0x10) ? 11 : 10);
+	  if (sci_preamble)
+	    sci_preamble= false;
+	  else
+	    {
+	      sci_tdr_full= false;
+	      sci_last[sci_n % 32]= sci_tdr;
+	      sci_n++;
+	      event('X', 0x102f, sci_tdr);
+	    }
+	}
+      if (spi_busy && cycles >= spi_end)
+	{
+	  spi_busy= false;
+	  reg[0x29]|= 0x80;	// SPIF: received byte is whatever the unknown slave shifted in
+	}
+      if (adc_busy && cycles - adc_start >= 128)
+	{
+	  adc_busy= false;
+	  reg[0x30]|= 0x80; // conversion completion is autonomous, not a read side effect
+	  adc_complete();
+	}
+    }
+  return 0;
+}
+
+// PORTA pins PA3-PA6 owned by OC5-OC2 (TCTL1 OMx:OLx not 0:0); PA7 by OC1M7 when DDRA7=1.
+u8_t
+cl_iaw8p::oc_pin_controlled(void)
+{
+  u8_t m= 0;
+  for (int k= 1; k < 5; k++)	// OC2..OC5
+    if ((reg[0x20] >> (2 * (4 - k))) & 3)
+      m|= 0x40 >> (k - 1);
+  if ((reg[0x26] & 0x80) && (reg[0x0c] & 0x80))
+    m|= 0x80;
+  return m;
+}
+
+void
+cl_iaw8p::set_pins(u8_t pins)
+{
+  u8_t outputs= 0x78 | ((reg[0x26] & 0x80) ? 0x80 : 0);
+  pins= (pins & outputs) | (pa_pins & ~outputs);
+  u8_t changed= pins ^ pa_pins;
+  if (!changed)
+    return;
+  for (int b= 0; b < 8; b++)
+    if (changed & (1 << b))
+      {
+	pa_changes[b]++;
+	(pa_pins & (1 << b) ? pa_high_w : pa_low_w)[b]= cycles - pa_edge_cycle[b];
+	pa_edge_cycle[b]= cycles;
+      }
+  pa_pins= pins;
+  event('O', 0x1000, pins);
+}
+
+// Automatic pin action of output compare k (0: OC1 .. 4: OC5) on a match or a CFORC force.
+void
+cl_iaw8p::oc_action(int k)
+{
+  u8_t pins= pa_pins;
+  if (k == 0)
+    {
+      u8_t m= reg[0x0c] & 0xf8 & ((reg[0x26] & 0x80) ? 0xff : 0x7f);
+      pins= (pins & ~m) | (reg[0x0d] & m);
+    }
+  else
+    {
+      u8_t bit= 0x40 >> (k - 1);	// OC2: PA6 .. OC5: PA3
+      switch ((reg[0x20] >> (2 * (4 - k))) & 3)
+	{
+	case 1: pins^= bit; break;	// toggle
+	case 2: pins&= ~bit; break;	// clear
+	case 3: pins|= bit; break;	// set
+	default: return;		// disconnected from the pin
+	}
+    }
+  set_pins(pins);
+}
+
+// SCSR with an idle receive line (H2): RDRF, IDLE, OR, NF, FE stay 0 (IDLE needs prior activity).
+u8_t
+cl_iaw8p::scsr(void)
+{
+  u8_t tdre= sci_tdr_full ? 0 : 0x80;
+  u8_t tc= (!sci_tdr_full && !sci_shifting && !sci_preamble) ? 0x40 : 0;
+  return tdre | tc;
+}
+
+// H2: the internal EEPROM starts with the supplied fill byte; false (after a violation) if not usable.
+bool
+cl_iaw8p::ee_ready(t_addr a)
+{
+  if (!ee_init)
+    {
+      if (cfg_get(8 + IAW8P_ADC) > 255)
+	{
+	  violation("read", a, -1, "internal EEPROM content unknown (H2 supplies a power-up fill value)");
+	  return false;
+	}
+      memset(ee, cfg_get(8 + IAW8P_ADC), sizeof(ee));
+      ee_init= true;
+    }
+  return true;
+}
+
+// H2: the four results of a finished sequence come from the supplied raw channel values.
+void
+cl_iaw8p::adc_complete(void)
+{
+  if (profile() != 2)
+    return;
+  u8_t c= reg[0x30];
+  for (int k= 0; k < 4; k++)
+    {
+      int ch= (c & 0x10) ? ((c & 0x0c) + k) : (c & 0x0f);	// MULT: four channels of a group
+      t_mem v= ch < IAW8P_ADC ? cfg_get(4 + ch) : IAW8P_NOT_SUPPLIED;	// 8-15: internal references
+      if (v > 255)
+	{
+	  adc_done= false;
+	  return;
+	}
+      adr[k]= v;
+    }
+  adc_done= true;
+}
+
+u8_t
+cl_iaw8p::reg_read(t_addr a)
+{
+  int r= a - 0x1000;
+  switch (r)
+    {
+    case 0x00:	// PORTA: output pins read back their level; input pins are supplied in H2
+      {
+	u8_t inputs= 0x07 | ((reg[0x26] & 0x80) ? 0 : 0x80);
+	if (profile() == 2 && cfg_get(5 + IAW8P_ADC) <= 255)
+	  {
+	    u8_t in= cfg_get(5 + IAW8P_ADC);
+	    if (crank_on())
+	      in= (in & ~0x81) | (crank_level ? 0x81 : 0);	// PA7 and PA0 carry the crank signal
+	    return (pa_pins & ~inputs) | (in & inputs);
+	  }
+	violation("port_read", a, -1, "PORTA input pin levels: external inputs are not modelled (H2 supplies them)");
+	return 0;
+      }
+    case 0x0b:	// CFORC always reads $00
+      return 0;
+    case 0x0c: case 0x0d:	// OC1M, OC1D
+      return reg[r];
+    case 0x10: case 0x11: case 0x12: case 0x13: case 0x14: case 0x15:	// TIC1-TIC3
+      if (!(tic_valid & (1 << ((r - 0x10) / 2))))
+	violation("register_read", a, -1, "TICx read before any input capture: content undefined after reset");
+      return (r & 1) ? tic[(r - 0x10) / 2] & 0xff : tic[(r - 0x10) / 2] >> 8;
+    case 0x0e: return tcnt >> 8;
+    case 0x0f: return tcnt & 0xff;
+    case 0x16: case 0x18: case 0x1a: case 0x1c: case 0x1e:
+      return toc[(r - 0x16) / 2] >> 8;
+    case 0x17: case 0x19: case 0x1b: case 0x1d: case 0x1f:
+      return toc[(r - 0x17) / 2] & 0xff;
+    case 0x09: case 0x20: case 0x21: case 0x22: case 0x23: case 0x24: case 0x25: case 0x26: case 0x27:
+    case 0x2b: case 0x2c: case 0x2d: case 0x39: case 0x3b: case 0x3c: case 0x3d:
+      return reg[r];
+    case 0x30:
+      return reg[0x30];
+    case 0x31: case 0x32: case 0x33: case 0x34:
+      if (profile() == 2 && adc_done)
+	return adr[r - 0x31];
+      violation("adc_result", a, -1, profile() == 2
+		? "A/D result before a completed conversion of supplied channels"
+		: "A/D result: analog sensor channels are not modelled (H2 supplies raw values)");
+      return 0;
+    case 0x2e:	// SCSR
+      if (profile() != 2)
+	break;
+      scsr_seen= scsr();
+      return scsr_seen;
+    case 0x2f:	// SCDR read: nothing was ever received, so the RDR content is unknown
+      if (profile() != 2)
+	break;
+      // The tracker holds one live unknown register. Never lose it to another unknown load.
+      if (dead_acc)
+        {
+          violation("register_read", a, -1, "A second unknown input would overwrite a live unknown-register tag");
+          return 0;
+        }
+      if (cur_key == 0x96 || cur_key == 0xa6 || cur_key == 0xb6 || cur_key == 0x1a6)
+	dead_acc= 'A';
+      else if (cur_key == 0xd6 || cur_key == 0xe6 || cur_key == 0xf6 || cur_key == 0x1e6)
+	dead_acc= 'B';
+      else
+	violation("register_read", a, -1, "SCDR: no character was received (idle line); content unknown");
+      return 0;
+    case 0x28:
+      return reg[r];
+    case 0x29:	// SPSR: reading a set flag arms its clearing sequence
+      spsr_seen= reg[r] & 0xd0;
+      return reg[r];
+    case 0x2a:	// SPDR: received data comes from an unknown device; only a discarded load may read it
+      reg[0x29]&= ~(spsr_seen & 0xc0);
+      spsr_seen&= ~0xc0;
+      // The tracker holds one live unknown register. Never lose it to another unknown load.
+      if (dead_acc)
+        {
+          violation("register_read", a, -1, "A second unknown input would overwrite a live unknown-register tag");
+          return 0;
+        }
+      if (cur_key == 0x96 || cur_key == 0xa6 || cur_key == 0xb6 || cur_key == 0x1a6)
+	dead_acc= 'A';
+      else if (cur_key == 0xd6 || cur_key == 0xe6 || cur_key == 0xf6 || cur_key == 0x1e6)
+	dead_acc= 'B';
+      else
+	violation("register_read", a, -1, "SPDR: received SPI data from an unknown device");
+      return 0;
+    case 0x08:
+      if (profile() == 2 && cfg_get(6 + IAW8P_ADC) <= 63)	// H2: supplied input pin levels
+	return ((reg[0x08] & reg[0x09]) | (cfg_get(6 + IAW8P_ADC) & ~reg[0x09])) & 0x3f;
+      // BSET/BCLR on PORTD: unknown input-pin bits only reach the input-pin latch bits and N/Z.
+      if (cur_key == 0x1c || cur_key == 0x1d || cur_key == 0x11c || cur_key == 0x11d)
+	{
+	  nz_unknown= true;
+	  u8_t mask= uc->rom->get(uc->instPC + (cur_key > 0xff ? 3 : 2));
+	  portd_unknown= (portd_unknown | (~reg[0x09] & 0x3f)) & ~mask;
+	  return reg[0x08];
+	}
+      violation("port_read", a, -1, "PORTD pin levels: external inputs are not modelled");
+      return 0;
+    }
+  violation("register_read", a, -1, "HC11 register not modelled");
+  return 0;
+}
+
+void
+cl_iaw8p::reg_write(t_addr a, u8_t v)
+{
+  int r= a - 0x1000;
+  bool early= cycles < 64;	// time-protected writes: first 64 E cycles after reset
+  switch (r)
+    {
+    case 0x3d:	// INIT
+      if (init_written || !early || v != 0x01)
+	violation("register_write", a, v, "INIT: only the reset mapping $01 within the first 64 E cycles is modelled");
+      init_written= true;
+      return;
+    case 0x39:	// OPTION: IRQE, DLY, CR1:0 are time protected
+      if (v & 0x40)
+	violation("register_write", a, v, "OPTION CSEL (RC A/D clock) not modelled");
+      reg[r]= early ? v : ((v & ~0x33) | (reg[r] & 0x33));
+      return;
+    case 0x24:	// TMSK2: PR1:0 time protected
+      if (early && !prescaler_written)
+	{
+	  reg[r]= v & 0xf3;
+	  prescaler_written= true;
+	}
+      else
+	reg[r]= (v & 0xf0) | (reg[r] & 0x03);
+      return;
+    case 0x23: case 0x25:	// TFLG1/TFLG2: write 1 to clear
+      reg[r]&= ~v;
+      return;
+    case 0x22:	// TMSK1
+      reg[r]= v;
+      return;
+    case 0x16: case 0x18: case 0x1a: case 0x1c: case 0x1e:	// TOCx high byte
+      toc[(r - 0x16) / 2]= (toc[(r - 0x16) / 2] & 0x00ff) | (v << 8);
+      return;
+    case 0x17: case 0x19: case 0x1b: case 0x1d: case 0x1f:	// TOCx low byte
+      toc[(r - 0x17) / 2]= (toc[(r - 0x17) / 2] & 0xff00) | v;
+      return;
+    case 0x00:	// PORTA: the latch drives output pins that no output compare owns (manual 7.3)
+      pa_latch= v;
+      set_pins((pa_pins & oc_pin_controlled()) | (v & ~oc_pin_controlled()));
+      return;
+    case 0x0b:	// CFORC: force the pin actions of the selected output compares, flags unchanged
+      for (int k= 4; k >= 0; k--)
+	if (v & (0x80 >> k))
+	  oc_action(k);
+      return;
+    case 0x0c:	// OC1M
+      reg[r]= v & 0xf8;
+      set_pins((pa_pins & oc_pin_controlled()) | (pa_latch & ~oc_pin_controlled()));
+      return;
+    case 0x0d:	// OC1D
+      reg[r]= v & 0xf8;
+      return;
+    case 0x20:	// TCTL1: pins released by an output compare return to the PORTA latch value
+      reg[r]= v;
+      set_pins((pa_pins & oc_pin_controlled()) | (pa_latch & ~oc_pin_controlled()));
+      return;
+    case 0x21:	// TCTL2: input-capture edge selection (H2: IC3 sees the crank signal; IC1/IC2 pins stay constant)
+      reg[r]= v;
+      return;
+    case 0x27:	// PACNT: counter; H2 crank edges increment it in event-counting mode
+      reg[r]= v;
+      return;
+    case 0x3b:	// PPROG: $00 keeps EEPROM programming off; H2 models the internal EEPROM (manual 4.5.4)
+      {
+	u8_t old= reg[r];
+	if (v && profile() != 2)
+	  violation("register_write", a, v, "PPROG: EEPROM programming not modelled (H2 models it)");
+	if (v & 0xc0)
+	  violation("register_write", a, v, "PPROG ODD/EVEN factory test modes not modelled");
+	if (!(old & 0x03) && (v & 0x03) == 0x03)
+	  v&= ~0x03;	// EELAT and EEPGM set by one write: neither is set
+	if ((v & 0x01) && !(old & 0x02))
+	  v&= ~0x01;	// EEPGM needs EELAT written to 1 earlier
+	if (!(old & 0x01) && (v & 0x01))
+	  ee_pgm_cycle= cycles;	// VPP on
+	if ((old & 0x01) && !(v & 0x01) && ee_latched)
+	  {
+	    // VPP off: the latched operation took effect if VPP stayed on for the specified 10 ms
+	    if (cycles - ee_pgm_cycle < 20000)
+	      violation("register_write", a, v, "EEPROM VPP on for less than 10 ms at the assumed 2 MHz E clock: result undefined");
+	    else if (old & 0x04)
+	      {
+		if (old & 0x10)
+		  ee[ee_addr - 0xb600]= 0xff;					// byte erase
+		else if (old & 0x08)
+		  memset(ee + ((ee_addr - 0xb600) & ~0x0f), 0xff, 16);		// row erase
+		else
+		  memset(ee, 0xff, sizeof(ee));					// bulk erase
+		ee_ops++;
+		event('E', ee_addr, 0xff);
+	      }
+	    else
+	      {
+		ee[ee_addr - 0xb600]&= ee_data;	// programming only changes 1s to 0s
+		ee_ops++;
+		event('E', ee_addr, ee_data);
+	      }
+	  }
+	if (!(v & 0x02))
+	  ee_latched= false;
+	reg[r]= v;
+	return;
+      }
+    case 0x26:	// PACTL (DDRA7 selects PA7 direction)
+      // H2: PA7 is a constant supplied input, so an enabled pulse accumulator sees no edges.
+      if ((v & 0x40) && profile() != 2)
+	violation("register_write", a, v, "PACTL PAEN: pulse accumulator input not modelled (H2 supplies PA7)");
+      if ((v & 0x60) == 0x60 && crank_on())
+	violation("register_write", a, v, "PACTL gated time accumulation with a crank signal: not modelled");
+      reg[r]= v;
+      set_pins((pa_pins & oc_pin_controlled()) | (pa_latch & ~oc_pin_controlled()));
+      return;
+    case 0x08:	// PORTD output latch
+      reg[r]= v;
+      if (cur_key != 0x1c && cur_key != 0x1d && cur_key != 0x11c && cur_key != 0x11d)
+	portd_unknown= 0; // a full store replaces unknown bits; read-modify-write preserves them
+      return;
+    case 0x09:	// DDRD
+      if (v & portd_unknown)
+	violation("register_write", a, v, "DDRD would drive PORTD latch bits copied from unknown input pins");
+      reg[r]= v;
+      return;
+    case 0x28:	// SPCR
+      reg[r]= v;
+      if (spsr_seen & 0x10)
+	reg[0x29]&= ~0x10;	// MODF clearing sequence complete
+      spsr_seen&= ~0x10;
+      if ((v & 0x50) == 0x50 && !(reg[0x09] & 0x20))
+	{
+	  // Master with SS (PD5) as an input: a low SS level is a mode fault (manual 8.7.4)
+	  if (profile() != 2 || cfg_get(6 + IAW8P_ADC) > 63)
+	    violation("register_write", a, v, "SPI master with SS input: SS pin level unknown (H2 supplies PORTD inputs)");
+	  else if (!(cfg_get(6 + IAW8P_ADC) & 0x20))
+	    {
+	      reg[0x29]|= 0x10;
+	      reg[0x28]&= ~0x50;
+	      reg[0x09]&= ~0x3c;
+	    }
+	}
+      return;
+    case 0x2a:	// SPDR write: master transfer of 8 bits at E/2, E/4, E/16 or E/32
+      {
+	static const int div[4]= { 2, 4, 16, 32 };
+	reg[0x29]&= ~(spsr_seen & 0xc0);
+	spsr_seen&= ~0xc0;
+	if ((reg[0x28] & 0x50) != 0x50)
+	  violation("register_write", a, v, "SPDR write while the SPI is not an enabled master: not modelled");
+	else if (spi_busy)
+	  reg[0x29]|= 0x40;	// WCOL: the write is ignored
+	else
+	  {
+	    spi_busy= true;
+	    spi_end= cycles + 8 * div[reg[0x28] & 3];
+	    spi_last[spi_n % 32]= v;
+	    spi_n++;
+	    event('S', a, v);
+	  }
+	return;
+      }
+    case 0x2b: case 0x2c:	// BAUD, SCCR1
+      if (r == 0x2b && (v & 0x88))
+	violation("register_write", a, v, "BAUD TCLR/RCKB test bits not modelled");
+      reg[r]= v;
+      return;
+    case 0x2d:	// SCCR2
+      if ((v & 0x08) && profile() != 2)
+	violation("register_write", a, v, "SCCR2 TE: SCI transmitter not modelled (H2 models it)");
+      if (v & 0x03)
+	violation("register_write", a, v, "SCCR2 RWU/SBK (wake-up, break) not modelled");
+      if ((v & 0x08) && !(reg[r] & 0x08))
+	sci_preamble= true;	// TE 0->1 queues an idle preamble
+      reg[r]= v;
+      return;
+    case 0x2f:	// SCDR write: loads the transmit data register; clears TDRE/TC after an SCSR read
+      if (profile() != 2)
+	break;
+      scsr_seen= 0;
+      sci_tdr= v;
+      sci_tdr_full= true;
+      return;
+    case 0x3c:	// HPRIO: only PSEL may change in normal modes, and only while I=1
+      if ((v ^ reg[r]) & 0xf0)
+	violation("register_write", a, v, "HPRIO mode bits change not modelled");
+      if (!(((class cl_m68hc11 *)uc)->cCC.get() & flagI))
+	violation("register_write", a, v, "HPRIO PSEL written with I=0 (manual: ignored); not modelled");
+      reg[r]= (reg[r] & 0xf0) | (v & 0x0f);
+      return;
+    case 0x30:	// ADCTL: starts a conversion sequence
+      if (!(reg[0x39] & 0x80))
+	violation("register_write", a, v, "ADCTL write with ADPU=0: A/D not powered");
+      reg[r]= v & 0x3f;
+      adc_busy= true;
+      adc_done= false;
+      adc_start= cycles;
+      return;
+    case 0x3a:	// COPRST: $55 arms, $AA services; reg[] keeps the last write for display
+      reg[r]= v;
+      if (v == 0x55)
+	cop_armed= true;
+      else if (v == 0xaa && cop_armed)
+	{
+	  cop_armed= false;
+	  if (cycles - cop_cycle > cop_gap_max)
+	    cop_gap_max= cycles - cop_cycle;
+	  cop_services++;
+	  cop_cycle= cycles;
+	  event('C', a, v);
+	}
+      return;
+    }
+  violation("register_write", a, v, "HC11 register not modelled");
+}
+
+t_mem
+cl_iaw8p::read(class cl_memory_cell *cell)
+{
+  if (conf(cell, NULL))
+    return cell->get();
+  t_addr a;
+  if (!uc->inst_exec || !uc->rom->is_owned(cell, &a))
+    return cell->get();	// console and loader: no side effects
+  int rg= region(a);
+  bool fetch= (a == uc->PC);
+  counts[rg][fetch ? 0 : 1]++;
+  if (rg == 6 && profile() == 2 && a >= 0xb600 && a <= 0xb7ff)
+    {
+      // H2: CONFIG EEON=1 inferred (dump bytes $B600-$B7FF are blank, firmware erases/programs there)
+      if (reg[0x3b] & 0x02)
+	violation(fetch ? "fetch" : "read", a, -1, "EEPROM read while PPROG EELAT=1 (manual: cannot be read)");
+      else if (ee_ready(a))
+	return ee[a - 0xb600];
+      return cell->get();
+    }
+  switch (rg)
+    {
+    case 0: case 4:
+      poison_pulled(a);
+      return cell->get();
+    case 6:
+      return cell->get();
+    case 2:
+      {
+	reg_rd[a - 0x1000]++;
+	u8_t v= reg_read(a);
+	if (!fetch)
+	  event('R', a, v);
+	return v;
+      }
+    case 3:
+      if (profile() == 2 && !fetch)
+	{
+	  // H2: the external latches read back what was written last.
+	  if (a == 0x1040 && has_latch1040) return latch1040;
+	  if (a == 0x1050 && has_latch1050) return latch1050;
+	  // H2: the board input bytes $1060 and $1080 are supplied simulation inputs (bit meanings unknown).
+	  t_mem in= a == 0x1060 ? cfg_get(3) : a == 0x1080 ? cfg_get(7 + IAW8P_ADC) : IAW8P_NOT_SUPPLIED;
+	  if (in <= 255)
+	    {
+	      u8_t v= in;
+	      event('R', a, v);
+	      return v;
+	    }
+	}
+      break;
+    }
+  violation(fetch ? "fetch" : "read", a, -1,
+	    rg == 3 ? "external I/O: board decode not known" : "address not mapped in this board model");
+  return cell->get();
+}
+
+void
+cl_iaw8p::write(class cl_memory_cell *cell, t_mem *val)
+{
+  if (conf(cell, val))
+    return;
+  t_addr a;
+  if (!uc->inst_exec || !uc->rom->is_owned(cell, &a))
+    return;	// loader and console writes store as requested
+  u8_t v= *val;
+  int rg= region(a);
+  counts[rg][2]++;
+  switch (rg)
+    {
+    case 0: case 4:
+      for (int i= 0; i < 4; i++)
+	if (poison_tag[i] && poison_addr[i] == a)
+	  poison_tag[i]= 0;	// overwritten: the unknown copy is gone
+      return;
+    case 2:
+      reg_wr[a - 0x1000]++;
+      event('W', a, v);
+      reg_write(a, v);
+      *val= cell->get();	// register state lives in reg[], the cell stays inert
+      return;
+    case 3:
+      if (profile() >= 1 && (a == 0x1040 || a == 0x1050))
+	{
+	  // H1: write-only latches with unknown function; value recorded, no effect modelled
+	  int base= a == 0x1040 ? 0 : 8;
+	  u8_t old= a == 0x1040 ? latch1040 : latch1050;
+	  bool had= a == 0x1040 ? has_latch1040 : has_latch1050;
+	  for (int b= 0; had && b < 8; b++)
+	    if ((old ^ v) & (1 << b))
+	      latch_changes[base + b]++;
+	  if (a == 0x1040) { latch1040= v; has_latch1040= true; }
+	  else { latch1050= v; has_latch1050= true; }
+	  event('L', a, v);
+	}
+      else
+	violation("write", a, v, "external I/O: board decode not known");
+      *val= cell->get();
+      return;
+    case 6:
+      if (profile() == 2 && a >= 0xb600 && a <= 0xb7ff)
+	{
+	  // EEPROM write: latched for programming only with EELAT=1 and EEPGM=0 (manual 4.5.4)
+	  if ((reg[0x3b] & 0x03) == 0x02 && ee_ready(a))
+	    {
+	      ee_latched= true;
+	      ee_addr= a;
+	      ee_data= v;
+	    }
+	  else if (!(reg[0x3b] & 0x01))
+	    violation("write", a, v, "EEPROM write with EELAT=0: not a programming sequence");
+	  *val= cell->get();
+	  return;
+	}
+      if (profile() >= 1 && v == cell->get())
+	rom_same_writes++;	// H1: indistinguishable whether EPROM ignores it or shadow RAM stores it
+      else
+	violation("write", a, v, profile() >= 1
+		  ? "EPROM-address write of a different value: shadow memory not modelled"
+		  : "EPROM-address write: board write behaviour not known");
+      *val= cell->get();
+      return;
+    }
+  violation("write", a, v, "address not mapped in this board model");
+  *val= cell->get();
+}
+
+// The highest-priority pending I-maskable source, or -1 (reference manual 5.5, Figures 5-3 to 5-5).
+int
+cl_iaw8p::pending_source(void)
+{
+  class cl_m68hc11 *u= (class cl_m68hc11 *)uc;
+  if (profile() != 2 || (u->cCC.get() & flagI) || last_key == 0x0e)
+    return -1;	// CLI: the next instruction always executes first (manual, CLI description)
+  bool req[IAW8P_SOURCES];
+  for (int i= 0; i < IAW8P_SOURCES; i++)
+    req[i]= iaw8p_sources[i].mask_reg
+      && (reg[iaw8p_sources[i].flag_reg] & iaw8p_sources[i].flag_bit)
+      && (reg[iaw8p_sources[i].mask_reg] & iaw8p_sources[i].mask_bit);
+  // H2: IRQ pin inactive. SCI with an idle receive line and no transmission: TDRE=TC=1, RDRF=OR=0.
+  u8_t sccr2= reg[0x2d];
+  req[13]= (reg[0x28] & 0x80) && (reg[0x29] & 0x90);	// SPIE and SPIF or MODF
+  req[14]= ((sccr2 & 0x80) && (sccr2 & 0x08) && (scsr() & 0x80)) || ((sccr2 & 0x40) && (scsr() & 0x40));
+  int promoted= reg[0x3c] & 0x0f;
+  if (promoted == 5)
+    promoted= 6;	// reserved code defaults to IRQ (Table 5-4)
+  for (int i= 0; i < IAW8P_SOURCES; i++)
+    if (req[i] && iaw8p_sources[i].psel == promoted)
+      return i;
+  for (int i= 0; i < IAW8P_SOURCES; i++)
+    if (req[i])
+      return i;
+  return -1;
+}
+
+t_addr
+cl_iaw8p::vector_of(int source)
+{
+  return iaw8p_sources[source].vector;
+}
